            "index": 0
          }
        ]
      ]
    },
    "Get Prices": {
      "main": [
        [
          {
            "node": "Parse Prices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Prices": {
      "main": [
        [
          {
            "node": "Send Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
